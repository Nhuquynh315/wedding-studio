# ── Database ───────────────────────────────────────────────────────────
# psycopg 3 scheme: postgresql+psycopg://  (NOT postgresql:// which defaults to psycopg2)
# Format: postgresql+psycopg://user:password@host:port/dbname
# Local Homebrew default (no password): postgresql+psycopg://user@localhost:5432/wedding_studio
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://user@localhost:5432/wedding_studio

# ── AI — Google Gemini ─────────────────────────────────────────────────
# OPTIONAL — only required to use the AI theme generation feature
# Obtain a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── JWT (Phase 3) ──────────────────────────────────────────────────────
# MUST be a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── macOS / WeasyPrint ──────────────────────────────────────────────────
# WeasyPrint needs Pango/Cairo system libs. uv-managed Python (standalone
# distribution) does not inherit Homebrew's dyld paths the way framework
# Pythons do, so we set it explicitly.
# Apple Silicon: /opt/homebrew/lib   Intel Mac: /usr/local/lib
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
